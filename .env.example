PORT=3000
DB_FILE=./data/db.json

# Optional MySQL persistence (configure to enable; falls back to JSON when unset/unreachable)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=

ADMIN_USERNAME=admin
# Recommended for deployment: scrypt$saltHex$hashHex (generate with: npm run hash-admin-password)
ADMIN_PASSWORD_HASH=
# 至少 12 位，生产环境必须更换
# Kept only as a local/demo fallback; ignored when ADMIN_PASSWORD_HASH is set
ADMIN_PASSWORD=replace-with-a-strong-password

WECHAT_APPID=your-miniprogram-appid
WECHAT_APP_SECRET=your-miniprogram-secret

# Comma-separated browser origins; unset defaults to localhost development origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
